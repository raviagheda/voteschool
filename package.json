{
  "name": "voteschool",
  "version": "1.0.0",
  "description": "Civic education web app that teaches Indian voters about the election process",
  "main": "server/dist/index.js",
  "scripts": {
    "dev": "concurrently \"tsx server/index.ts\" \"npm run dev --prefix client\"",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:server && npm run build --prefix client",
    "start": "node server/dist/index.js",
    "test": "jest --verbose",
    "lint": "eslint .",
    "deploy": "gcloud run deploy voteschool --source . --region us-central1 --allow-unauthenticated --env-vars-file .env.yaml --project galvanic-circle-494411-u4"
  },
  "keywords": [
    "civic-education",
    "india",
    "elections",
    "voting",
    "democracy"
  ],
  "author": "VoteSchool Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "node-fetch": "^2.7.0",
    "sanitize-html": "^2.14.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "@types/node-fetch": "^2.6.13",
    "@types/sanitize-html": "^2.11.0",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
